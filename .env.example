# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects may use: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# xAI Grok (default provider)
AI_PROVIDER=xai
XAI_API_KEY=xai-xxx
XAI_MODEL=grok-4.5
XAI_VISION_MODEL=grok-4.5

# Optional GroqCloud fallback
# GROQ_API_KEY=gsk_xxx
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Email payment reminders (Resend)
RESEND_API_KEY=re_xxx
RESEND_FROM=NutriClinic AI <payments@yourdomain.com>

# SMS payment reminders (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Or use a Messaging Service instead of FROM_NUMBER:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx

# Production URL used in links and auth configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PWA / background Web Push
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# NutriClinic AI v7.0 SaaS / pilot administration
# Comma-separated e-mail addresses allowed to open /platform-admin
PLATFORM_ADMIN_EMAILS=hasan@example.com
# Public contact used on the sales landing page
NEXT_PUBLIC_SALES_EMAIL=hello@yourdomain.com
# One-time secret used to expose the first platform-admin registration screen.
# Visit /login?platform_setup=YOUR_SECRET only during initial setup.
PLATFORM_SETUP_TOKEN=replace-with-a-long-random-secret
